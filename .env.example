# LLM provider (any OpenAI-compatible endpoint). Key is only used server-side.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_SMALL=openai/gpt-oss-20b
LLM_MODEL_BIG=openai/gpt-oss-120b

# Leave empty in local dev to use an in-memory MongoDB (data is lost on restart).
MONGODB_URI=

# advise | propose | auto
AUTONOMY_MODE=propose
DEMO_RATE_LIMIT_PER_HOUR=20

# Server port and allowed web origins (comma-separated).
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Web only: API base URL baked in at build time. Empty = same origin (Vite proxies /api in dev).
VITE_API_URL=
