# LLM provider (any OpenAI-compatible endpoint). Key is only used server-side.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_SMALL=openai/gpt-oss-20b
LLM_MODEL_BIG=openai/gpt-oss-120b

# Leave empty in local dev to use an in-memory MongoDB (data is lost on restart).
MONGODB_URI=

# advise | propose | auto
AUTONOMY_MODE=propose
DEMO_RATE_LIMIT_PER_HOUR=20

# Server port and allowed web origins (comma-separated).
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Web only: API base URL baked in at build time. Empty = same origin (Vite proxies /api in dev).
VITE_API_URL=

# Vendor dispatch call (optional, server only). The app only ever dials DEMO_VENDOR_PHONE.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, e.g. +17165550100
TWILIO_FROM_NUMBER=
DEMO_VENDOR_PHONE=
# Long random string; the manager enters it in Settings to see the Call button.
CALL_ADMIN_KEY=
CALLS_ENABLED=false
# Public base URL of the API (Twilio webhooks), e.g. https://<service>.onrender.com
PUBLIC_API_URL=
# Minutes before retrying a missed routine / low call (2 for a demo video).
DEMO_RETRY_MINUTES=90
# Secret header for POST /api/jobs/run-due (external cron). Empty = route disabled.
JOBS_SECRET=
